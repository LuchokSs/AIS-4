<Window x:Class="KohonenLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KohonenLab.Controls"
        Title="Лабораторная работа 4 — самоорганизующиеся карты Кохонена"
        Height="760" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E5EC" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Файл данных:" VerticalAlignment="Center" Margin="0,0,8,0" Width="86"/>
                    <Button Content="Обзор" Click="Browse_Click" DockPanel.Dock="Right" MinWidth="70"/>
                    <Button Content="Загрузить" Command="{Binding LoadCommand}" DockPanel.Dock="Right" MinWidth="85"/>
                    <TextBox x:Name="DataPathBox" Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="Кластеров:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding ClusterCount}" Width="42"/>
                        <Button Content="Оценить" Command="{Binding EstimateCommand}" Margin="6,0,0,0" MinWidth="72"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="Эпох:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding Epochs}" Width="55"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="α₀:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding InitialAlpha}" Width="48"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="Шаг утомления:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding FatigueStep}" Width="48"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="Затухание:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding FatigueDecay}" Width="48"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding Seed}" Width="48"/>
                    </StackPanel>
                    <Button Content="Обучить обе модели" Command="{Binding TrainCommand}"/>
                    <Button Content="Экспорт JSON" Command="{Binding ExportCommand}"/>
                    <TextBlock Text="{Binding EstimatedClusters, StringFormat='Оценка: {0}'}" VerticalAlignment="Center" Foreground="#5A6C80"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F7F9FC">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="#33465B"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8" FontSize="12">
            <TabItem Header="1. Исходные данные">
                <controls:ScatterPlot Series="{Binding OriginalPlot}"/>
            </TabItem>
            <TabItem Header="2. WTA — веса нейронов">
                <controls:ScatterPlot Series="{Binding WtaPlot}"/>
            </TabItem>
            <TabItem Header="3. Утомляемость — веса">
                <controls:ScatterPlot Series="{Binding FatiguePlot}"/>
            </TabItem>
            <TabItem Header="4. Центры кластеров">
                <controls:ScatterPlot Series="{Binding CentersPlot}"/>
            </TabItem>
            <TabItem Header="5. Кривая обучения">
                <controls:ScatterPlot Series="{Binding ErrorPlot}"/>
            </TabItem>
            <TabItem Header="6. Таблица данных">
                <DataGrid ItemsSource="{Binding DataRows}" AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="#F5F8FC" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F2}" Width="90"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F2}" Width="90"/>
                        <DataGridTextColumn Header="x'" Binding="{Binding NormalizedX, StringFormat=F4}" Width="90"/>
                        <DataGridTextColumn Header="y'" Binding="{Binding NormalizedY, StringFormat=F4}" Width="90"/>
                        <DataGridTextColumn Header="Кластер WTA" Binding="{Binding WtaCluster}" Width="100"/>
                        <DataGridTextColumn Header="Кластер (утомл.)" Binding="{Binding FatigueCluster}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="7. Сравнение">
                <DataGrid ItemsSource="{Binding Comparison}" AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="#F5F8FC" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Показатель" Binding="{Binding Indicator}" Width="260"/>
                        <DataGridTextColumn Header="WTA" Binding="{Binding Wta}" Width="180"/>
                        <DataGridTextColumn Header="С утомляемостью" Binding="{Binding Fatigue}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
